# Copy this file to .env and fill every value. Never commit .env.

# --- Django ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bot.example.com,localhost,127.0.0.1
PUBLIC_BASE_URL=https://bot.example.com

# --- Server ---
# A free port on the server, e.g. 3500 (see docs/DEPLOY.md, step 2).
APP_PORT=3500
# Generate: python3 -c "import secrets; print(secrets.token_hex(24))"   (letters and digits only)
POSTGRES_PASSWORD=

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Without the @, e.g. lomistore_bot
TELEGRAM_BOT_USERNAME=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Public channel username without the @, e.g. lomistore
TELEGRAM_CHANNEL_USERNAME=
# Staff group id. Send /chatid in the group to get it (looks like -1001234567890)
TELEGRAM_ADMIN_CHAT_ID=
